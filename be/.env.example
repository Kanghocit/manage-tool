# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/license_admin?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# License key hashing pepper (HMAC-SHA256)
LICENSE_KEY_PEPPER=change-me-license-pepper

# Refresh token hashing pepper (SHA-256)
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper

# CORS - allow danh sách origin, ngăn cách bởi dấu phẩy
# Dev: http://localhost:5173
# Prod: chrome-extension://YOUR_EXTENSION_ID,https://kang.vn
CORS_ORIGINS=http://localhost:5173

# Bật/tắt tự đăng ký (false = chỉ admin tạo user)
ALLOW_REGISTER=false

# Seed admin (chỉ dùng cho prisma seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Admin
