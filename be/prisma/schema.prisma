generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  admin
  user
}

enum UserStatus {
  active
  blocked
}

enum LicenseStatus {
  unused
  active
  expired
  blocked
}

enum PurchaseOrderStatus {
  pending
  paid
  failed
  expired
}

enum LicenseRequestStatus {
  pending
  approved
  rejected
}

enum RegistrationSource {
  self
  admin
}

enum SupportSessionStatus {
  open
  waiting_admin
}

enum SupportMessageSender {
  user
  bot
  admin
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String
  fullName             String
  role                 RoleName           @default(user)
  status               UserStatus         @default(active)
  registeredDeviceId   String?
  registrationSource   RegistrationSource @default(self)
  createdByAdminId     String?
  welcomeTrialLicenseId String?           @unique
  welcomeEmailSentAt   DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  createdByAdmin           User?    @relation("AdminCreatedUsers", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  adminCreatedUsers        User[]   @relation("AdminCreatedUsers")
  welcomeTrialLicense      License? @relation("WelcomeTrialLicense", fields: [welcomeTrialLicenseId], references: [id], onDelete: SetNull)
  createdLicenses          License[]            @relation("LicenseCreator")
  deletedLicenses          License[]            @relation("LicenseDeleter")
  activatedLicenses        License[]            @relation("LicenseActivator")
  activations              LicenseActivation[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]           @relation("AuditActor")
  purchaseOrders           PurchaseOrder[]
  licenseRequests          LicenseRequest[]     @relation("LicenseRequestUser")
  reviewedLicenseRequests  LicenseRequest[]     @relation("LicenseRequestReviewer")
  createdPackagePromotions LicensePackagePromotion[] @relation("PackagePromotionCreator")
  supportSessions          SupportSession[]
  authHandoffCodes         AuthHandoffCode[]

  @@index([registrationSource, welcomeEmailSentAt])
}

model AuthHandoffCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model LicensePackage {
  id            String   @id @default(uuid())
  code          String   @unique
  durationDays  Int
  baseAmountVnd Int
  labelKey      String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  promotions LicensePackagePromotion[]
}

model LicensePackagePromotion {
  id             String   @id @default(uuid())
  packageId      String
  promoAmountVnd Int
  startsAt       DateTime
  endsAt         DateTime
  label          String?
  isEnabled      Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  package   LicensePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("PackagePromotionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([startsAt, endsAt])
}

model PurchaseOrder {
  id                   String               @id @default(uuid())
  userId               String
  packageCode          String
  amountVnd            Int
  originalAmountVnd    Int?
  promotionId          String?
  transferContent      String               @unique
  status               PurchaseOrderStatus  @default(pending)
  sepayTransactionId   Int?                 @unique
  fulfilledLicenseId   String?              @unique
  webhookPayload       Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfilledLicense License? @relation("PurchaseFulfilledLicense", fields: [fulfilledLicenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model License {
  id                String        @id @default(uuid())
  licenseKeyHash    String        @unique
  /// Full key for admin UI only (activate still uses hash). Legacy rows may be null.
  licenseKeyPlain   String?
  licenseKeyPreview String
  status            LicenseStatus @default(unused)
  durationDays      Int?
  expiresAt         DateTime?
  maxDevices        Int           @default(1)
  notes             String?
  deletedAt         DateTime?

  createdById   String?
  deletedById   String?
  activatedById String?
  activatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User? @relation("LicenseCreator",   fields: [createdById],   references: [id])
  deletedBy   User? @relation("LicenseDeleter",   fields: [deletedById],   references: [id])
  activatedBy User? @relation("LicenseActivator", fields: [activatedById], references: [id])

  activations          LicenseActivation[]
  fulfilledFromOrder   PurchaseOrder?   @relation("PurchaseFulfilledLicense")
  fulfilledFromRequest LicenseRequest?  @relation("LicenseRequestFulfilled")
  welcomeTrialForUser  User?            @relation("WelcomeTrialLicense")

  @@index([status])
  @@index([activatedById])
  @@index([deletedAt])
}

model LicenseActivation {
  id          String    @id @default(uuid())
  licenseId   String
  userId      String
  deviceId    String
  deviceName  String?
  userAgent   String?
  lastIp      String?
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId],    references: [id])

  @@unique([licenseId, deviceId])
  @@index([userId])
  @@index([revokedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LicenseRequest {
  id                 String               @id @default(uuid())
  userId             String
  durationDays       Int                  @default(1)
  note               String?
  status             LicenseRequestStatus @default(pending)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectReason       String?
  fulfilledLicenseId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user             User     @relation("LicenseRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?    @relation("LicenseRequestReviewer", fields: [reviewedById], references: [id])
  fulfilledLicense License? @relation("LicenseRequestFulfilled", fields: [fulfilledLicenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
  @@index([action])
}

model SupportSession {
  id        String               @id @default(uuid())
  userId    String
  status    SupportSessionStatus @default(open)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model SupportMessage {
  id        String               @id @default(uuid())
  sessionId String
  sender    SupportMessageSender
  content   String
  createdAt DateTime             @default(now())

  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
