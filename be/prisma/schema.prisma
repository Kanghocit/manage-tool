generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  admin
  user
}

enum UserStatus {
  active
  blocked
}

enum LicenseStatus {
  unused
  active
  expired
  blocked
}

enum PurchaseOrderStatus {
  pending
  paid
  failed
  expired
}

enum LicenseRequestStatus {
  pending
  approved
  rejected
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  passwordHash         String
  fullName             String
  role                 RoleName         @default(user)
  status               UserStatus       @default(active)
  registeredDeviceId   String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  createdLicenses   License[]            @relation("LicenseCreator")
  deletedLicenses   License[]            @relation("LicenseDeleter")
  activatedLicenses License[]            @relation("LicenseActivator")
  activations       LicenseActivation[]
  refreshTokens     RefreshToken[]
  auditLogs                AuditLog[]           @relation("AuditActor")
  purchaseOrders           PurchaseOrder[]
  licenseRequests          LicenseRequest[]     @relation("LicenseRequestUser")
  reviewedLicenseRequests  LicenseRequest[]     @relation("LicenseRequestReviewer")
  automationTools          AutomationTool[]     @relation("AutomationToolCreator")
  browserProfiles          BrowserProfile[]     @relation("BrowserProfileCreator")
  automationRuns           AutomationRun[]      @relation("AutomationRunCreator")
}

enum AutomationRunStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum AutomationSessionStatus {
  pending
  running
  completed
  failed
  cancelled
}

model AutomationTool {
  id               String    @id @default(uuid())
  name             String
  description      String?
  steps            Json
  defaultLoopCount Int       @default(1)
  createdById      String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy User            @relation("AutomationToolCreator", fields: [createdById], references: [id])
  runs      AutomationRun[]

  @@index([createdById])
  @@index([deletedAt])
}

model BrowserProfile {
  id             String   @id @default(uuid())
  name           String
  userAgent      String?
  proxyUrl       String?
  viewportWidth  Int?
  viewportHeight Int?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User                     @relation("BrowserProfileCreator", fields: [createdById], references: [id])
  sessions  AutomationRunSession[]

  @@index([createdById])
}

model AutomationRun {
  id          String              @id @default(uuid())
  toolId      String
  loopCount   Int
  status      AutomationRunStatus @default(pending)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tool      AutomationTool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("AutomationRunCreator", fields: [createdById], references: [id])
  sessions  AutomationRunSession[]

  @@index([toolId])
  @@index([status])
  @@index([createdById])
}

model AutomationRunSession {
  id          String                  @id @default(uuid())
  runId       String
  profileId   String
  status      AutomationSessionStatus @default(pending)
  currentLoop Int                     @default(0)
  log         String                  @default("")
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  run     AutomationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  profile BrowserProfile @relation(fields: [profileId], references: [id])

  @@index([runId])
  @@index([profileId])
}

model PurchaseOrder {
  id                   String               @id @default(uuid())
  userId               String
  packageCode          String
  amountVnd            Int
  transferContent      String               @unique
  status               PurchaseOrderStatus  @default(pending)
  sepayTransactionId   Int?                 @unique
  fulfilledLicenseId   String?              @unique
  webhookPayload       Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfilledLicense License? @relation("PurchaseFulfilledLicense", fields: [fulfilledLicenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model License {
  id                String        @id @default(uuid())
  licenseKeyHash    String        @unique
  /// Full key for admin UI only (activate still uses hash). Legacy rows may be null.
  licenseKeyPlain   String?
  licenseKeyPreview String
  status            LicenseStatus @default(unused)
  durationDays      Int?
  expiresAt         DateTime?
  maxDevices        Int           @default(1)
  notes             String?
  deletedAt         DateTime?

  createdById   String?
  deletedById   String?
  activatedById String?
  activatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User? @relation("LicenseCreator",   fields: [createdById],   references: [id])
  deletedBy   User? @relation("LicenseDeleter",   fields: [deletedById],   references: [id])
  activatedBy User? @relation("LicenseActivator", fields: [activatedById], references: [id])

  activations          LicenseActivation[]
  fulfilledFromOrder   PurchaseOrder?   @relation("PurchaseFulfilledLicense")
  fulfilledFromRequest LicenseRequest?  @relation("LicenseRequestFulfilled")

  @@index([status])
  @@index([activatedById])
  @@index([deletedAt])
}

model LicenseActivation {
  id          String    @id @default(uuid())
  licenseId   String
  userId      String
  deviceId    String
  deviceName  String?
  userAgent   String?
  lastIp      String?
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId],    references: [id])

  @@unique([licenseId, deviceId])
  @@index([userId])
  @@index([revokedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LicenseRequest {
  id                 String               @id @default(uuid())
  userId             String
  durationDays       Int                  @default(1)
  note               String?
  status             LicenseRequestStatus @default(pending)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectReason       String?
  fulfilledLicenseId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user             User     @relation("LicenseRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?    @relation("LicenseRequestReviewer", fields: [reviewedById], references: [id])
  fulfilledLicense License? @relation("LicenseRequestFulfilled", fields: [fulfilledLicenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
  @@index([action])
}
