# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/license_admin?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# License key hashing pepper (HMAC-SHA256)
LICENSE_KEY_PEPPER=change-me-license-pepper

# Refresh token hashing pepper (SHA-256)
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper

# CORS - allow danh sách origin, ngăn cách bởi dấu phẩy
# Dev: http://localhost:5173
# Prod: chrome-extension://YOUR_EXTENSION_ID,https://kang.vn
CORS_ORIGINS=http://localhost:5173

# Bật/tắt tự đăng ký (false = chỉ admin tạo user)
ALLOW_REGISTER=false

# URL app công khai (link trong email chào mừng)
APP_PUBLIC_URL=http://localhost:5173

# SMTP — gửi email welcome trial cho user tự đăng ký (admin bấm Send)
SMTP_HOST=
SMTP_PORT=58
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Zalo Tools"

# Seed admin (chỉ dùng cho prisma seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Admin

# VietQR (https://img.vietqr.io) — bank + STK; amount + nội dung CK do API ghép theo gói đơn hàng
VIETQR_BANK_CODE=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# SePay QR động https://qr.sepay.vn/img?… — amount & des (LIC…) do API ghép theo gói; chỉ cần bank + STK
# SEPAY_QR_ACC để trống thì dùng VIETQR_ACCOUNT_NO làm acc
SEPAY_QR_BANK=
SEPAY_QR_ACC=
# Tuỳ chọn: template / download — xem tài liệu SePay (qr.sepay.vn)
# SEPAY_QR_TEMPLATE=

# QR theo TỪNG đơn (số tiền + nội dung LIC… đúng gói): backend tự ghép URL — KHÔNG khai amount/des trong .env.
# Ưu tiên: SEPAY_QR_BANK (+ SEPAY_QR_ACC hoặc VIETQR_ACCOUNT_NO) → https://qr.sepay.vn/img?acc=…&bank=…&amount=…&des=…
# Hoặc: VIETQR_* → img.vietqr.io …
#
# SEPAY_CHECKOUT_QR_URL chỉ dùng khi cần MỘT ảnh QR cố định (URL không đổi theo gói). Lúc đó user xem số tiền + nội dung CK trên app, không nhúng trong ảnh.
SEPAY_CHECKOUT_QR_URL=

# SePay webhook — URL: https://<domain>/hooks/sepay-payments
# Trên SePay: Webhook → Thanh toán Tools → bảo mật chọn "API Key" → bấm nút "API Key" để xem/tạo key → copy vào đây (chỉ hiện đủ lần đầu khi tạo).
# Server so khớp header: Authorization: Apikey <SEPAY_WEBHOOK_API_KEY>
# Tài liệu: https://developer.sepay.vn/en/sepay-webhooks/xac-thuc
SEPAY_WEBHOOK_API_KEY=

# Telegram — thông báo khi user xin cấp license 1 ngày
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
