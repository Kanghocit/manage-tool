generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  admin
  user
}

enum UserStatus {
  active
  blocked
}

enum LicenseStatus {
  unused
  active
  expired
  blocked
}

enum PurchaseOrderStatus {
  pending
  paid
  failed
  expired
}

enum LicenseRequestStatus {
  pending
  approved
  rejected
}

enum RegistrationSource {
  self
  admin
}

enum SupportSessionStatus {
  open
  waiting_admin
}

enum SupportMessageSender {
  user
  bot
  admin
}

enum StudyWordStatus {
  new
  learning
  review
  mastered
}

enum CaseStudySetStatus {
  draft
  published
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  passwordHash         String
  fullName             String
  role                 RoleName           @default(user)
  status               UserStatus         @default(active)
  registeredDeviceId   String?
  registrationSource   RegistrationSource @default(self)
  createdByAdminId     String?
  welcomeTrialLicenseId String?           @unique
  welcomeEmailSentAt   DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  createdByAdmin           User?    @relation("AdminCreatedUsers", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  adminCreatedUsers        User[]   @relation("AdminCreatedUsers")
  welcomeTrialLicense      License? @relation("WelcomeTrialLicense", fields: [welcomeTrialLicenseId], references: [id], onDelete: SetNull)
  createdLicenses          License[]            @relation("LicenseCreator")
  deletedLicenses          License[]            @relation("LicenseDeleter")
  activatedLicenses        License[]            @relation("LicenseActivator")
  activations              LicenseActivation[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]           @relation("AuditActor")
  purchaseOrders           PurchaseOrder[]
  licenseRequests          LicenseRequest[]     @relation("LicenseRequestUser")
  reviewedLicenseRequests  LicenseRequest[]     @relation("LicenseRequestReviewer")
  createdPackagePromotions LicensePackagePromotion[] @relation("PackagePromotionCreator")
  supportSessions          SupportSession[]
  authHandoffCodes         AuthHandoffCode[]
  studyWordLists           StudyWordList[]
  studyListEnrollments     StudyListEnrollment[]
  studyWordProgress        StudyWordProgress[]
  studyUserSettings        StudyUserSettings?
  studyDailyActivities     StudyDailyActivity[]
  studyHiddenLists         StudyHiddenList[]
  studyHiddenWords         StudyHiddenWord[]
  studyWordOverrides       StudyWordOverride[]
  studyListMetaOverrides   StudyListMetaOverride[]
  studyUserWords           StudyUserWord[]
  caseStudySetsCreated     CaseStudySet[]      @relation("CaseStudySetCreator")
  caseStudyAttempts        CaseStudyAttempt[]

  @@index([registrationSource, welcomeEmailSentAt])
}

model AuthHandoffCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model LicensePackage {
  id            String   @id @default(uuid())
  code          String   @unique
  durationDays  Int
  baseAmountVnd Int
  labelKey      String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  promotions LicensePackagePromotion[]
}

model LicensePackagePromotion {
  id             String   @id @default(uuid())
  packageId      String
  promoAmountVnd Int
  startsAt       DateTime
  endsAt         DateTime
  label          String?
  isEnabled      Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  package   LicensePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("PackagePromotionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([startsAt, endsAt])
}

model PurchaseOrder {
  id                   String               @id @default(uuid())
  userId               String
  packageCode          String
  amountVnd            Int
  originalAmountVnd    Int?
  promotionId          String?
  transferContent      String               @unique
  status               PurchaseOrderStatus  @default(pending)
  sepayTransactionId   Int?                 @unique
  fulfilledLicenseId   String?              @unique
  webhookPayload       Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfilledLicense License? @relation("PurchaseFulfilledLicense", fields: [fulfilledLicenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model License {
  id                String        @id @default(uuid())
  licenseKeyHash    String        @unique
  /// Full key for admin UI only (activate still uses hash). Legacy rows may be null.
  licenseKeyPlain   String?
  licenseKeyPreview String
  status            LicenseStatus @default(unused)
  durationDays      Int?
  expiresAt         DateTime?
  maxDevices        Int           @default(1)
  notes             String?
  deletedAt         DateTime?

  createdById   String?
  deletedById   String?
  activatedById String?
  activatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User? @relation("LicenseCreator",   fields: [createdById],   references: [id])
  deletedBy   User? @relation("LicenseDeleter",   fields: [deletedById],   references: [id])
  activatedBy User? @relation("LicenseActivator", fields: [activatedById], references: [id])

  activations          LicenseActivation[]
  fulfilledFromOrder   PurchaseOrder?   @relation("PurchaseFulfilledLicense")
  fulfilledFromRequest LicenseRequest?  @relation("LicenseRequestFulfilled")
  welcomeTrialForUser  User?            @relation("WelcomeTrialLicense")

  @@index([status])
  @@index([activatedById])
  @@index([deletedAt])
}

model LicenseActivation {
  id          String    @id @default(uuid())
  licenseId   String
  userId      String
  deviceId    String
  deviceName  String?
  userAgent   String?
  lastIp      String?
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId],    references: [id])

  @@unique([licenseId, deviceId])
  @@index([userId])
  @@index([revokedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LicenseRequest {
  id                 String               @id @default(uuid())
  userId             String
  durationDays       Int                  @default(1)
  note               String?
  status             LicenseRequestStatus @default(pending)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectReason       String?
  fulfilledLicenseId String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user             User     @relation("LicenseRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?    @relation("LicenseRequestReviewer", fields: [reviewedById], references: [id])
  fulfilledLicense License? @relation("LicenseRequestFulfilled", fields: [fulfilledLicenseId], references: [id])

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
  @@index([action])
}

model SupportSession {
  id        String               @id @default(uuid())
  userId    String
  status    SupportSessionStatus @default(open)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model SupportMessage {
  id        String               @id @default(uuid())
  sessionId String
  sender    SupportMessageSender
  content   String
  createdAt DateTime             @default(now())

  session SupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model StudyWordList {
  id          String   @id
  userId      String?
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  words      StudyWord[]
  enrollments StudyListEnrollment[]

  @@index([userId])
}

model StudyWord {
  id           String   @id
  listId       String
  word         String
  pos          String
  ipa          String   @default("")
  definitionVi String
  definitionEn String
  examples     Json
  imageEmoji   String   @default("📖")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  list StudyWordList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, sortOrder])
}

model StudyUserWord {
  id           String   @id @default(uuid())
  userId       String
  listId       String
  word         String
  pos          String
  ipa          String   @default("")
  definitionVi String
  definitionEn String
  examples     Json
  imageEmoji   String   @default("📖")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, listId])
}

model StudyListEnrollment {
  userId     String
  listId     String
  enrolledAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  list StudyWordList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
}

model StudyWordProgress {
  id             String          @id @default(uuid())
  userId         String
  listId         String
  wordId         String
  status         StudyWordStatus @default(new)
  intervalDays   Int             @default(0)
  easiness       Float           @default(2.5)
  repetitions    Int             @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  correctCount   Int             @default(0)
  wrongCount     Int             @default(0)
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId, wordId])
  @@index([userId, listId])
}

model StudyUserSettings {
  userId         String  @id
  dailyNewWords  Int     @default(30)
  showAllLearned Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyDailyActivity {
  userId       String
  activityDate DateTime @db.Date
  reviewCount  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId, activityDate])
}

model StudyHiddenList {
  userId String
  listId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
}

model StudyHiddenWord {
  userId String
  listId String
  wordId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listId, wordId])
}

model StudyWordOverride {
  userId       String
  wordId       String
  listId       String
  word         String
  pos          String
  ipa          String   @default("")
  definitionVi String
  definitionEn String
  examples     Json
  imageEmoji   String   @default("📖")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId, listId])
}

model StudyListMetaOverride {
  userId      String
  listId      String
  title       String?
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
}

model CaseStudySet {
  id          String             @id @default(uuid())
  title       String
  description String             @default("")
  status      CaseStudySetStatus @default(draft)
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User                 @relation("CaseStudySetCreator", fields: [createdById], references: [id], onDelete: Cascade)
  passages  CaseStudyPassage[]
  questions CaseStudyQuestion[]
  attempts  CaseStudyAttempt[]

  @@index([status])
  @@index([createdById])
}

model CaseStudyPassage {
  id        String @id @default(uuid())
  setId     String
  part      Int
  label     String @default("")
  contentEn String @default("")
  contentVi String @default("")
  sortOrder Int    @default(0)

  set       CaseStudySet        @relation(fields: [setId], references: [id], onDelete: Cascade)
  questions CaseStudyQuestion[]

  @@index([setId, sortOrder])
}

model CaseStudyQuestion {
  id            String  @id @default(uuid())
  setId         String
  passageId     String?
  part          Int
  number        Int
  stemEn        String
  options       Json
  correctKey    String
  explanationVi String
  sortOrder     Int     @default(0)

  set     CaseStudySet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  passage CaseStudyPassage? @relation(fields: [passageId], references: [id], onDelete: SetNull)

  @@unique([setId, number])
  @@index([setId, sortOrder])
  @@index([passageId])
}

model CaseStudyAttempt {
  id           String   @id @default(uuid())
  userId       String
  setId        String
  currentIndex Int      @default(0)
  completed    Boolean  @default(false)
  answers      Json     @default("{}")
  updatedAt    DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  set  CaseStudySet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
  @@index([userId])
}
